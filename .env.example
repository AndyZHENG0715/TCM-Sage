# LLM Provider Configuration
LLM_PROVIDER=alibaba          # Provider: alibaba, openai, google, anthropic, openrouter, together
LLM_MODEL=qwen3-max           # Optional: Override default model for the provider
LLM_TEMPERATURE=1            # Temperature for informational queries (can increase for creativity: 0.3-0.7)
PRESCRIPTIVE_TEMPERATURE=0.0 # Temperature for prescriptive/diagnostic queries (keep at 0.0 for accuracy)
                              # Only increase if you need more creative medical suggestions (not recommended)

# Classifier LLM Configuration (for query routing)
CLASSIFIER_LLM_PROVIDER=alibaba    # Lightweight model provider for fast query classification
CLASSIFIER_LLM_MODEL=qwen-flash    # Small, fast model (recommended: qwen3-0.6b, gpt-4o-mini)
CLASSIFIER_LLM_TEMPERATURE=0.0     # Keep at 0.0 for consistent classification

# Verifier LLM Configuration (for self-critique)
VERIFIER_LLM_PROVIDER=alibaba      # Provider for self-critique verification (e.g., openai, alibaba)
VERIFIER_LLM_MODEL=qwen-flash       # Powerful model for accurate verification (e.g., gpt-4o, qwen3-max)
VERIFIER_LLM_TEMPERATURE=0.0       # Keep at 0.0 for rigorous verification

# Verification Prompt Configuration
VERIFICATION_PROMPT="You are a strict verification auditor for a Traditional Chinese Medicine RAG system.

Your task: Determine if the Proposed Answer is FAITHFUL to the provided Context.

FAITHFULNESS CRITERIA:
1. The answer must be based on the provided Context.
2. ALLOWED: Synthesis, summarization, and logical inference derived from the Context.
3. ALLOWED: Use of standard TCM terminology to explain concepts found in the Context.
4. FORBIDDEN: Introducing external knowledge NOT supported by the Context (e.g., modern medicine, antibiotics, germ theory).
5. FORBIDDEN: Contradicting the Context.

Context:
{context}

Question:
{question}

Proposed Answer:
{answer}

Respond with ONLY one word: 'SUPPORTED' or 'UNSUPPORTED'.
Verification Result:"

# Retrieval Configuration
RETRIEVAL_K=10                 # Number of document chunks to retrieve (3-10 recommended)
                              # Higher values: More comprehensive answers, slower responses
                              # Lower values: Faster responses, potentially less context

# Hybrid Retrieval Configuration (Knowledge Graph)
HYBRID_RETRIEVAL_ENABLED=true    # Set to true to enable hybrid vector+graph retrieval
GRAPH_DATA_PATH=data\graph\symmap\symmap_entities.json  # SymMap KG JSON (see data/graph/symmap/README.md)
GRAPH_DEPTH=2                     # Max traversal depth for graph search (1-2 recommended)

# System Prompt Override (overrides DEFAULT_SYSTEM_PROMPT in main.py)
# Uncomment and edit to customize without touching code.
# The hardcoded default is a Chinese TCM clinical reference prompt with 辨证论治 guidance.
# SYSTEM_PROMPT_OVERRIDE=你的自定义提示词...

# Output Format Configuration (Future UI Support)
OUTPUT_FORMAT=detailed        # detailed, concise, academic
CITATION_STYLE=chapter         # chapter, page, section (display format only, no performance impact)

# Provider-specific API Keys (only set the one you're using)
# IMPORTANT: Keep this file free of real secrets; use `.env` locally for actual keys.
DASHSCOPE_API_KEY=your-alibaba-dashscope-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
TOGETHER_API_KEY=your-together-api-key-here

# Local LLM Configuration (no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1     # Default Ollama endpoint
# LMSTUDIO_BASE_URL=http://localhost:1234/v1    # Default LM Studio endpoint

# UI Configuration
FEEDBACK_FORM_URL=https://forms.gle/Sm62ucNSKQzGGPJ76
